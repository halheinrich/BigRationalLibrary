<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources for this solution. <clear /> drops any inherited sources
    from machine-level NuGet.Config so the build is reproducible from this
    file alone. Directory.Build.props turns on RestorePackagesWithLockFile, and
    without this file the committed packages.lock.json claimed a
    reproducibility it could not deliver: it resolved against whatever
    machine-level configuration happened to be present, which a different
    clone need not have.

    Deliberately no `github` source and no packageSourceCredentials block.
    This repository is the producer of HalHeinrich.Numerics.BigRational, not a
    consumer of it, and it references no HalHeinrich.* package at all - so the
    GITHUB_PACKAGES_PAT the consuming members need would be a restore failure
    mode here with nothing behind it. Publishing is unaffected: the publish
    workflow names its feed inline, in the source argument of its
    `dotnet nuget push` step, so no source in this file is read on that path.
    Add the source back only if a HalHeinrich.* package is ever referenced
    from this repo.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping pins every package to a specific feed. With one source that
    is a formality today, but it is the guard that stays correct if a second
    source is ever added: an unmapped source silently becomes a candidate for
    every package, which is the dependency-confusion opening.

    Note this file cannot defend the HalHeinrich.* namespace by mapping it to
    the github feed, because that source is deliberately absent above and a
    mapping cannot name a source that does not exist. Nothing is lost: source
    mapping governs restore, and this repo restores no HalHeinrich.* package.
    The defence belongs in the repositories that consume one. If a
    HalHeinrich.* PackageReference is ever added here, add the github source
    and map that pattern to it in the same change.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
