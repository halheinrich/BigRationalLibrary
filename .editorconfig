root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C# files
[*.cs]
indent_size = 4

# Project / build files
[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

# JSON / config
[*.{json,yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

##############################################################################
# C# language and code-style rules
##############################################################################

[*.cs]

# 'this.' and 'Me.' qualifiers
dotnet_style_qualification_for_field    = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method   = false:warning
dotnet_style_qualification_for_event    = false:warning

# Language keywords vs framework type names for type references
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access             = true:warning

# Modifier preferences
dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order              = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning
dotnet_style_readonly_field                  = true:warning

# Expression-level preferences
dotnet_style_object_initializer                  = true:suggestion
dotnet_style_collection_initializer              = true:suggestion
dotnet_style_explicit_tuple_names                = true:warning
dotnet_style_prefer_inferred_tuple_names         = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_auto_properties              = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return     = true:suggestion

# Null-checking preferences
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation    = true:suggestion

# 'var' preferences
csharp_style_var_for_built_in_types    = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere             = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods      = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_operators    = when_on_single_line:suggestion
csharp_style_expression_bodied_properties   = true:suggestion
csharp_style_expression_bodied_indexers     = true:suggestion
csharp_style_expression_bodied_accessors    = true:suggestion

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# Null-checking
csharp_style_throw_expression                = true:suggestion
csharp_style_conditional_delegate_call       = true:warning

# Code-block preferences
csharp_prefer_braces                                  = when_multiline:suggestion
csharp_style_namespace_declarations                   = file_scoped:warning
csharp_style_prefer_method_group_conversion           = true:suggestion
csharp_style_prefer_top_level_statements              = false:suggestion

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

##############################################################################
# Analyzer severities
##############################################################################

# CA1062: Validate arguments of public methods.
# We use ArgumentNullException.ThrowIfNull / pattern checks; this rule is noisy
# for value types and operator overloads where validation belongs in the ctor.
dotnet_diagnostic.CA1062.severity = none

# CA1303: Do not pass literals as localized parameters.
# Not a localized library.
dotnet_diagnostic.CA1303.severity = none

# CA1716: Identifiers should not match keywords.
# Math vocabulary doesn't track CLS keyword reservations.
dotnet_diagnostic.CA1716.severity = none

# CA1815: Override equals and operator equals on value types.
# Enforced at the type level by IEquatable<T>; analyzer handled by code.
# Default severity (warning -> error) is fine.

# CA2225: Provide friendly named alternates for operator overloads.
# Permanently suppressed. Ten hits, three different cases, three different
# reasons - no one reason reaches all ten, and the reason recorded here
# before enumerated four.
#
# FIVE are the arithmetic operators - op_Addition, op_Subtraction,
# op_Multiply, op_Division, op_UnaryPlus - where the operator IS the
# canonical spelling. INumberBase<T> declares no Add, Subtract, Multiply,
# Divide or Plus; it inherits IAdditionOperators and its siblings, and
# IUnaryPlusOperators declares only op_UnaryPlus. A named alternate would be
# a second spelling of a rule the operators already state, and named
# alternates are a pre-generic-math CLS convention. op_UnaryNegation is
# absent from the hits only because Negate already exists - which is what
# made this group look like four rather than five.
#
# TWO are the explicit conversions, op_Explicit to double and to decimal,
# and generic math says nothing about them: TryConvertTo* is about producing
# another INumberBase, not a named ToDouble(). Their reason is this
# umbrella's own - an explicit cast signals you are leaving exactness, and a
# friendly ToDouble() makes that look routine.
#
# THREE are the implicit widenings from int, long and BigInteger, and for
# these the named alternate already exists. FromInteger(BigInteger) produces
# exactly what the three operators produce, and int and long widen to
# BigInteger implicitly, so the one method covers the family; CA2225 matches
# per-operator names and so cannot see that. The (BigInteger, BigInteger)
# constructor and Create reach the same values by name again. The exactness
# reason above does not merely fail to reach this group - it points the
# other way, because these are total, lossless widenings INTO exactness.
# Three type-specific spellings of a conversion that cannot fail would be
# surface without capability.
#
# BigRational does now target generic math: halheinrich/Math#34 ruled the set
# and it implements the ten operator interfaces, and not INumberBase<T> or
# INumber<T>. That neither created nor removed a hit - the count was measured
# again at ten, in the same three groups, after the declarations landed - and
# it does not carry the suppression either. The three reasons above stand on
# their own, which is why this line never waited on the answer.
dotnet_diagnostic.CA2225.severity = none

# IDE0290: Use primary constructor.
# Stylistic preference; primary constructors aren't always clearer.
dotnet_diagnostic.IDE0290.severity = suggestion

# IDE0005: Remove unnecessary using directives.
# Explicit, because the rule's build-time default is silent: the baseline's
# "0 warnings under AnalysisMode=All" never included it (halheinrich/Math#43).
# It needs GenerateDocumentationFile as a documented prerequisite
# (roslyn#41640), which is why the test project no longer opts out of that.
dotnet_diagnostic.IDE0005.severity = warning

# CA1707: Identifiers should not contain underscores.
# Test method names use underscores by convention (Method_Condition_Result).
# CA1508: Avoid dead conditional code.
# Tests intentionally exercise trivially-true / trivially-false conditions
# to verify operator and method behavior under known inputs.
[**/*Tests.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1508.severity = none

# CA1515: Types can be made internal.
# Kept, although it is now inert for the classes that actually hold tests.
#
# Measured in this repo on 2026-09-03, with this line temporarily removed:
# under the old test tooling (xunit 2.6.6, Test.Sdk 17.9.0, runner 2.5.7,
# coverlet 6.0.0) CA1515 fired on all three test classes; after bumping only
# those four packages it fired on none. That lag was the whole reason this
# repo raised CA1515 and no other member did.
#
# The exemption is keyed on test-method attributes, not on xunit types in
# general, so it does not cover every public type a test project needs. Probed
# on the same date, under the new tooling and with this line removed: a public
# shared fixture carrying no attribute of its own, and a public
# [CollectionDefinition] marker, both still tripped the rule. Those types have
# to be public for xunit to use them.
#
# So this stays as a standing guard rather than being deleted as spent. xunit
# v2 discovers only public test classes, and the failure mode if the rule were
# obeyed is the dangerous one: not a red build, but quieter discovery that
# still reports green.
dotnet_diagnostic.CA1515.severity = none
